# Backend only. Never use NEXT_PUBLIC_ for these values.
CALLE_API_KEY=
# Keep false until an owner and explicitly authorized destination are configured.
OFFHIRE_ENABLE_LIVE=false
# Comma-separated account emails from trusted Sites authentication.
OFFHIRE_OWNER_EMAILS=
# Comma-separated exact E.164 numbers owned by or authorized for this operator.
OFFHIRE_ALLOWED_PHONES=
# Hard cap on newly submitted calls, including uncertain or rejected attempts.
OFFHIRE_CALL_LIMIT=5
# Random 32-byte token in the callback path; callbacks are additionally re-fetched.
OFFHIRE_WEBHOOK_TOKEN=
OFFHIRE_WEBHOOK_URL=
